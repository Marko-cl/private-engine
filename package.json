{
  "name": "private-context-engine",
  "version": "0.1.0",
  "description": "Local-first private personal activity tracker",
  "main": "dist/main/main.js",
  "author": "",
  "license": "MIT",
  "scripts": {
    "build": "tsc && copyfiles -u 2 src/renderer/**/* dist/renderer",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron .",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js",
    "performance": "npm run build && node tests/performance.phase22.js",
    "recovery": "npm run build && node tests/database-recovery.phase22.js",
    "release-check": "npm run build && node scripts/release-check.js",
    "clean-startup": "npm run build && node tests/clean-startup.phase24.js",
    "package:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "active-win": "^8.2.1",
    "better-sqlite3": "^11.3.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.7.4",
    "copyfiles": "^2.4.1",
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3",
    "typescript": "^5.6.2"
  },
  "build": {
    "appId": "com.privatecontextengine.desktop",
    "productName": "Private Context Engine",
    "copyright": "Copyright (c) 2026",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/main/**/*",
      "dist/renderer/**/*",
      "package.json",
      "!**/*.ts",
      "!**/*.map"
    ],
    "asar": true,
    "extraMetadata": {
      "main": "dist/main/main.js"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "deleteAppDataOnUninstall": false
    },
    "publish": null
  },
  "overrides": {
    "cacache": "21.0.1",
    "make-fetch-happen": "16.0.1",
    "node-gyp": "13.1.0",
    "tar": "7.5.22",
    "electron-builder-squirrel-windows": "26.15.3"
  }
}
